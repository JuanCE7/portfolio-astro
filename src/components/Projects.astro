---
import ProjectCard from "./ProjectCard.astro";
const { t } = Astro.props;

const projects = [
  {
    index: "01",
    title: t("projects.testcase.title"),
    description: t("projects.testcase.description"),
    imageUrl: "/testcase.png",
    projectUrl: "https://testcasecraftunl.vercel.app/",
    tags: [
      "Next.js",
      "Nest.js",
      "Postgres",
      "Prisma",
      "API Cohere",
      "Supabase",
    ],
  },
  {
    index: "02",
    title: t("projects.megonline.title"),
    description: t("projects.megonline.description"),
    imageUrl: "/megonline.png",
    projectUrl: "https://megonline.coopmego.com/",
    tags: ["React", "Storybook", "Node.js", "Jenkins"],
  },
  {
    index: "03",
    title: t("projects.laberintos.title"),
    description: t("projects.laberintos.description"),
    imageUrl: "/laberinto.png",
    projectUrl: "https://laberintosapp.netlify.app/",
    tags: ["React", "TypeScript", "Node.js", "Tailwind"],
  },
  {
    index: "04",
    title: t("projects.dental.title"),
    description: t("projects.dental.description"),
    imageUrl: "/dental.png",
    projectUrl: "https://castilloclinicadental.netlify.app/",
    tags: ["Astro", "Node.js", "Tailwind"],
  },
  {
    index: "05",
    title: t("projects.angular.title"),
    description: t("projects.angular.description"),
    imageUrl: "/angular.png",
    projectUrl: "https://angularcruddev.netlify.app/",
    tags: ["Angular", "Node.js", "Tailwind"],
  },
  {
    index: "06",
    title: t("projects.sales.title"),
    description: t("projects.sales.description"),
    imageUrl: "/market.png",
    projectUrl: "https://www.youtube.com/watch?v=VBIS78X73vk",
    tags: ["Java", "Java FX", "MariaDB", "XAMP"],
  },
  {
    index: "07",
    title: t("projects.literature.title"),
    description: t("projects.literature.description"),
    imageUrl: "/literature.png",
    projectUrl: "https://redescubriendolohispanoamericano.netlify.app/",
    tags: ["React", "Typescript", "Node.js", "Netlify", "Tailwind"],
  },
  {
    index: "08",
    title: t("projects.gestiona.title"),
    description: t("projects.gestiona.description"),
    imageUrl: "/gestiona.png",
    projectUrl:
      "https://play.google.com/store/apps/details?id=com.coopmego.gestiona",
    tags: [".NET", "C#", "Javascript", "Sybase", "Postgres"],
  },
  {
    index: "09",
    title: t("projects.club.title"),
    description: t("projects.club.description"),
    imageUrl: "/clubestudio.png",
    projectUrl:
      "https://www.youtube.com/watch?v=It3ghVwjpsY&list=PLiULZndoCzyp3cwol7_RmkPOyAgMZ_0Cy&index=2",
    tags: ["Java", "Java FX", "YouTube", "Juego", "SQL", "POO"],
  },
];
---

<section id="projects" class="py-20 section-fade">
  <p
    class="font-mono text-xs text-ink-400 dark:text-neutral-500 tracking-widest uppercase mb-10"
  >
    {t("projects.title")}
  </p>

  <div
    class="flex flex-col divide-y divide-surface-300 dark:divide-neutral-800"
  >
    {
      projects.map((project) => (
        <ProjectCard
          index={project.index}
          title={project.title}
          description={project.description}
          imageUrl={project.imageUrl}
          projectUrl={project.projectUrl}
          tags={project.tags}
          t={t}
        />
      ))
    }
  </div>
</section>

<hr class="border-surface-300 dark:border-neutral-800" />

<style>
  .section-fade {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }
  .section-fade.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function initSectionFade() {
    const observer = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add("visible");
        }),
      { threshold: 0.05 },
    );
    document
      .querySelectorAll(".section-fade")
      .forEach((el) => observer.observe(el));
  }
  document.addEventListener("astro:page-load", initSectionFade);
</script>
