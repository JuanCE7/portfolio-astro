---
interface Props {
  index: string;
  title: string;
  description: string;
  imageUrl: string;
  projectUrl: string;
  tags?: string[];
  t: any;
}

const { index, title, description, imageUrl, projectUrl, tags = [], t } = Astro.props;
---

<article class="group py-10 flex flex-col gap-6">
  <!-- Header row -->
  <div class="flex items-baseline gap-4">
    <span class="font-mono text-xs text-ink-400 dark:text-neutral-500 flex-shrink-0">{index}</span>
    <h3 class="text-lg font-semibold text-ink-900 dark:text-neutral-100 group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">
      {title}
    </h3>
  </div>

  <!-- Content: image + text side by side on md+ -->
  <div class="flex flex-col sm:flex-row gap-6 items-start pl-8">
    <!-- Thumbnail -->
    <a
      href={projectUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-shrink-0 w-full sm:w-48 rounded-md overflow-hidden border border-white/50 dark:border-neutral-700/50"
    >
      <img
        src={imageUrl}
        alt={title}
        class="w-full h-32 sm:h-28 object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    </a>

    <!-- Description + tags + link -->
    <div class="flex flex-col gap-3 flex-1 min-w-0">
      <p class="text-sm text-ink-700 dark:text-neutral-400 leading-relaxed">
        {description}
      </p>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map(tag => (
            <span class="font-mono text-xs px-2 py-0.5 border border-white/50 dark:border-neutral-700/50 text-ink-400 dark:text-neutral-500 rounded bg-white/30 dark:bg-neutral-800/40">
              {tag}
            </span>
          ))}
        </div>
      )}

      <a
        href={projectUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-sm font-medium text-accent dark:text-accent-dark hover:underline underline-offset-4 w-fit mt-1"
      >
        {t("projects.see")}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
