---
const PETAL_COUNT = 26;
const PETAL_PATHS = [
  "M 13,0 C 21,0 26,6 26,13 C 26,20 21,26 13,29 C 5,26 0,20 0,13 C 0,6 5,0 13,0 Z",
  "M 11,0 C 18,0 22,5 22,12 C 22,21 17,28 11,32 C 5,28 0,21 0,12 C 0,5 4,0 11,0 Z",
  "M 14,0 C 22,0 27,6 27,14 C 27,22 22,28 14,31 C 6,28 0,22 0,14 C 0,6 6,0 14,0 Z",
];
---

<div class="jp-scene" aria-hidden="true" transition:persist>

  <!-- ── Background images (scroll-revealed, parallax) ── -->
  <div class="jp-bg-images">
    <img src="/parte_light.jpg" class="jp-bg-img jp-bg-light" alt="" fetchpriority="high" />
    <img src="/parte_black.jpg" class="jp-bg-img jp-bg-dark"  alt="" fetchpriority="low" />
  </div>

  <!-- ── Falling sakura petals ── -->
  {Array.from({ length: PETAL_COUNT }).map((_, i) => {
    const pathIndex = i % PETAL_PATHS.length;
    const delay = ((i * 0.73) % 20).toFixed(2);
    return (
      <svg class={`petal petal--${i % 3}`} style={`--delay: ${delay}s`}
        viewBox="0 0 30 35" xmlns="http://www.w3.org/2000/svg">
        <path d={PETAL_PATHS[pathIndex]}/>
        <line x1="14" y1="3" x2="14" y2="28"
          stroke="currentColor" stroke-width="0.6" stroke-linecap="round" opacity="0.25"/>
      </svg>
    );
  })}
</div>

<style>
  /* ── Container ──────────────────────────── */
  .jp-scene {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  /* ── Background images ───────────────────── */
  /*  Extends 120px beyond viewport so parallax
      shift never reveals an empty edge           */
  .jp-bg-images {
    position: absolute;
    inset: -120px;
    opacity: 0;            /* JS drives this */
    will-change: opacity, transform;
    /* Soft top fade so image blends into page bg */
    -webkit-mask-image: linear-gradient(to bottom,
      transparent 0%,
      rgba(0,0,0,0.15) 12%,
      rgba(0,0,0,0.65) 28%,
      black 48%);
    mask-image: linear-gradient(to bottom,
      transparent 0%,
      rgba(0,0,0,0.15) 12%,
      rgba(0,0,0,0.65) 28%,
      black 48%);
  }

  .jp-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.6s ease;
  }

  .jp-bg-dark { opacity: 0; }
  :global(.dark) .jp-bg-light { opacity: 0; }
  :global(.dark) .jp-bg-dark  { opacity: 1; }

  /* ── Petals ─────────────────────────────── */
  .petal {
    position: absolute;
    top: -40px;
    animation: petal-fall var(--dur, 18s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  .petal--0 {
    width: 20px; height: 24px;
    color: rgba(196,30,58,0.12);
    fill: rgba(196,30,58,0.58);
    filter: drop-shadow(0 1px 2px rgba(196,30,58,0.25));
  }
  .petal--1 {
    width: 14px; height: 17px;
    color: rgba(220,90,110,0.1);
    fill: rgba(220,90,110,0.48);
    filter: drop-shadow(0 1px 2px rgba(220,90,110,0.2));
  }
  .petal--2 {
    width: 24px; height: 29px;
    color: rgba(240,140,160,0.08);
    fill: rgba(240,140,160,0.38);
    filter: drop-shadow(0 1px 3px rgba(196,30,58,0.15));
  }

  :global(.dark) .petal--0 { fill: rgba(232,50,77,0.40); }
  :global(.dark) .petal--1 { fill: rgba(210,80,100,0.30); }
  :global(.dark) .petal--2 { fill: rgba(200,110,130,0.24); }

  @keyframes petal-fall {
    0% {
      transform: translateY(-40px) translateX(0) rotate(var(--rot0,0deg)) rotateY(0deg) scale(var(--sc,1));
      opacity: 0;
    }
    6%  { opacity: 1; }
    20% { transform: translateY(18vh) translateX(var(--x1,30px))  rotate(var(--rot1,55deg))  rotateY(60deg)  scale(var(--sc,1)); }
    40% { transform: translateY(38vh) translateX(var(--x2,-25px)) rotate(var(--rot2,130deg)) rotateY(0deg)   scale(var(--sc,1)); }
    60% { transform: translateY(58vh) translateX(var(--x1,30px))  rotate(var(--rot3,200deg)) rotateY(-60deg) scale(var(--sc,1)); }
    80% { transform: translateY(78vh) translateX(var(--x2,-25px)) rotate(var(--rot4,290deg)) rotateY(0deg)   scale(var(--sc,1)); }
    93% { opacity: 0.7; }
    100% {
      transform: translateY(112vh) translateX(0) rotate(var(--rot5,380deg)) rotateY(90deg) scale(var(--sc,1));
      opacity: 0;
    }
  }
</style>

<script>
  let _scrollHandler: (() => void) | null = null;

  function initScene() {
    // ── Randomise petals ──────────────────────
    document.querySelectorAll<HTMLElement>(".petal").forEach((el) => {
      const left  = 2 + Math.random() * 96;
      const dur   = 14 + Math.random() * 12;
      const sc    = 0.65 + Math.random() * 0.8;
      const x1    =  20 + Math.random() * 60;
      const x2    = -(20 + Math.random() * 50);
      const rot0  = Math.random() * 60;
      const delta = 60 + Math.random() * 80;

      el.style.left = `${left}%`;
      el.style.setProperty("--dur",  `${dur}s`);
      el.style.setProperty("--sc",   `${sc}`);
      el.style.setProperty("--x1",   `${x1}px`);
      el.style.setProperty("--x2",   `${x2}px`);
      el.style.setProperty("--rot0", `${rot0}deg`);
      el.style.setProperty("--rot1", `${rot0 + delta * 0.7}deg`);
      el.style.setProperty("--rot2", `${rot0 + delta * 1.4}deg`);
      el.style.setProperty("--rot3", `${rot0 + delta * 2.1}deg`);
      el.style.setProperty("--rot4", `${rot0 + delta * 2.8}deg`);
      el.style.setProperty("--rot5", `${rot0 + delta * 3.5}deg`);
    });

    // ── Scroll-reveal + parallax for background images ───
    const bgImages = document.querySelector<HTMLElement>(".jp-bg-images");
    if (!bgImages) return;

    if (_scrollHandler) window.removeEventListener("scroll", _scrollHandler);

    _scrollHandler = () => {
      const scrolled  = window.scrollY;
      const maxScroll = Math.max(document.body.scrollHeight - window.innerHeight, 1);
      const p = scrolled / maxScroll;

      // Bell curve: fade in 0→35%, hold 35→65%, fade out 65→100%
      let opacity = 0;
      if (p < 0.35) {
        opacity = (p / 0.35) * 0.92;
      } else if (p < 0.65) {
        opacity = 0.92;
      } else {
        opacity = ((1 - p) / 0.35) * 0.92;
      }
      bgImages.style.opacity = String(Math.max(0, opacity));

      // Parallax: image starts 100px below rest, rises as user scrolls
      // Total travel: 200px over the full scroll distance
      const translateY = 100 - scrolled * (200 / maxScroll);
      bgImages.style.transform = `translateY(${translateY}px)`;
    };

    window.addEventListener("scroll", _scrollHandler, { passive: true });
    _scrollHandler();
  }

  document.addEventListener("astro:page-load", initScene);
</script>
