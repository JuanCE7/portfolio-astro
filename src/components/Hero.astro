---
const { t } = Astro.props;
---

<section
  id="hero"
  class="min-h-screen flex flex-col justify-center py-24 fade-in relative"
>
  <!-- Japanese name — vertical calligraphy on right edge -->
  <div class="absolute right-0 top-0 h-full hidden md:flex items-center pr-1 select-none pointer-events-none" aria-hidden="true">
    <span class="font-serif text-xs tracking-[0.45em] text-ink-200 dark:text-neutral-800 opacity-70"
      style="writing-mode: vertical-rl; text-orientation: mixed; letter-spacing: 0.45em;">
      フアン・フランシスコ・カスティージョ
    </span>
  </div>

  <div class="space-y-8">
    <!-- Name + location -->
    <p class="font-mono text-sm text-ink-400 dark:text-neutral-500 tracking-widest uppercase">
      {t("hero.name")} &middot; {t("hero.location")}
    </p>

    <!-- Headline -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tight tracking-tight text-ink-900 dark:text-neutral-100 max-w-2xl">
      {t("hero.headline")}
    </h1>

    <!-- Subtitle -->
    <p class="font-mono text-base text-ink-400 dark:text-neutral-400 max-w-lg">
      {t("hero.subtitle")}
    </p>

    <!-- Decorative code snippet -->
    <div class="border border-white/70 dark:border-white/10 rounded-xl overflow-hidden max-w-xs bg-white/65 dark:bg-neutral-900/75 backdrop-blur-sm shadow-md shadow-black/5">
      <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-white/50 dark:border-neutral-700/50">
        <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
      </div>
      <pre class="font-mono text-xs sm:text-sm p-4 text-ink-700 dark:text-neutral-300 leading-relaxed overflow-x-auto"><code><span class="text-accent dark:text-accent-dark">const</span> <span class="text-ink-900 dark:text-neutral-100">juan_castillo</span> <span class="text-accent dark:text-accent-dark">=</span> &#123;
  stack<span class="text-ink-400">:</span> [<span class="text-green-600 dark:text-green-400">'Nest.js'</span><span class="text-ink-400">,</span> <span class="text-green-600 dark:text-green-400">'Node'</span><span class="text-ink-400">,</span> <span class="text-green-600 dark:text-green-400">'TS'</span>]<span class="text-ink-400">,</span>
  available<span class="text-ink-400">:</span> <span class="text-blue-500 dark:text-blue-400">true</span><span class="text-ink-400">,</span>
  coffee<span class="text-ink-400">:</span> <span class="text-green-600 dark:text-green-400">"required ☕"</span><span class="text-ink-400">,</span>
&#125;</code></pre>
    </div>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-start gap-4 pt-2">
      <a
        href="#projects"
        class="inline-flex items-center gap-2 px-6 py-3 bg-accent dark:bg-accent-dark text-white rounded-lg font-medium text-sm hover:opacity-90 transition-opacity"
      >
        {t("hero.cta.projects")}
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="/CVCastilloJuan.pdf"
        download
        class="inline-flex items-center gap-2 px-6 py-3 border border-surface-300 dark:border-neutral-700 text-ink-700 dark:text-neutral-300 rounded-lg font-medium text-sm hover:border-accent dark:hover:border-accent-dark hover:text-accent dark:hover:text-accent-dark transition-colors"
      >
        {t("hero.cta.cv")}
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</section>

<style>
  .fade-in {
    animation: fadeIn 0.6s ease both;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
