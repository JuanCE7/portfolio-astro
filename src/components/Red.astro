---
const { t } = Astro.props;

const phoneNumber = "593987466394";
const defaultMessage = "Hola, me gustaría contactar contigo";

const links = [
  {
    label: "LinkedIn",
    url: "https://www.linkedin.com/in/juan-castillo-181637277/",
  },
  {
    label: "GitHub",
    url: "https://github.com/JuanCE7",
  },
  {
    label: "WhatsApp",
    url: `https://wa.me/${phoneNumber}?text=${encodeURIComponent(defaultMessage)}`,
  },
];
---

<section id="red" class="py-20 section-fade">
  <p class="font-mono text-xs text-ink-400 dark:text-neutral-500 tracking-widest uppercase mb-10">{t("contact.title")}</p>

  <div class="max-w-lg">
    <h2 class="text-3xl sm:text-4xl font-bold text-ink-900 dark:text-neutral-100 leading-tight mb-4">
      {t("contact.cta.title")}
    </h2>
    <p class="text-ink-700 dark:text-neutral-400 mb-8 leading-relaxed">
      {t("contact.cta.body")}
    </p>

    <!-- Primary CTA -->
    <a
      href="mailto:juancastiestrella@gmail.com"
      class="inline-flex items-center gap-2 px-6 py-3 bg-accent dark:bg-accent-dark text-white rounded-lg font-medium text-sm hover:opacity-90 transition-opacity mb-8"
    >
      juancastiestrella@gmail.com
      <span aria-hidden="true">→</span>
    </a>

    <!-- Secondary links -->
    <div class="flex flex-wrap gap-4">
      {links.map(link => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-sm text-ink-400 dark:text-neutral-500 hover:text-accent dark:hover:text-accent-dark transition-colors underline underline-offset-4"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .section-fade {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .section-fade.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function initSectionFade() {
    const observer = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
      { threshold: 0.1 }
    );
    document.querySelectorAll('.section-fade').forEach(el => observer.observe(el));
  }
  document.addEventListener('astro:page-load', initSectionFade);
</script>
